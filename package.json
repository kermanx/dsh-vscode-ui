{
  "name": "dsh-vscode-ui",
  "version": "0.2.2",
  "type": "module",
  "description": "VS Code Classic workbench for DSH, with an activity bar and session explorer",
  "license": "MIT",
  "author": "kermanx",
  "homepage": "https://github.com/kermanx/dsh-vscode-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kermanx/dsh-vscode-ui.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack": "npm run build && npm pack",
    "prepublishOnly": "npm run build",
    "install:dsh": "dsh plugin --profile web add ."
  },
  "devDependencies": {
    "@iconify-json/codicon": "^1.2.74",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  }
}
